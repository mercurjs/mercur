{
  "name": "@mercurjs/core",
  "version": "2.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/mercurjs/mercur",
    "directory": "packages/core"
  },
  "description": "Core plugin for MercurJS.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    ".": {
      "types": "./.medusa/server/src/with-mercur.d.ts",
      "default": "./.medusa/server/src/with-mercur.js"
    },
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    },
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": {
      "types": "./.medusa/server/src/modules/*/index.d.ts",
      "default": "./.medusa/server/src/modules/*/index.js"
    },
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./with-mercur": {
      "types": "./.medusa/server/src/with-mercur.d.ts",
      "default": "./.medusa/server/src/with-mercur.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "marketplace",
    "multi-vendor",
    "medusajs",
    "ecommerce",
    "open-source-marketplace",
    "headless-commerce",
    "ai-ready",
    "marketplace-framework",
    "medusa-plugin",
    "medusa-v2"
  ],
  "scripts": {
    "build": "bun ./node_modules/@mercurjs/cli/dist/index.js codegen && rm -rf .medusa && tsc --declaration --outDir .medusa/server",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "tsc --declaration --outDir .medusa/server"
  },
  "devDependencies": {
    "cors": "^2.8.5",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/test-utils": "2.18.0",
    "@medusajs/ui": "4.1.19",
    "@mercurjs/types": "2.3.1",
    "@swc/core": "^1.7.28",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "yalc": "^1.0.0-pre.53",
    "@medusajs/types": "2.18.0",
    "multer": "^2.0.2",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "@mercurjs/cli": "2.3.1"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.18.0",
    "@medusajs/cli": ">=2.18.0",
    "@medusajs/framework": ">=2.18.0",
    "@medusajs/icons": ">=2.18.0",
    "@medusajs/medusa": ">=2.18.0",
    "@medusajs/test-utils": ">=2.18.0",
    "express": "^4.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "pkg-dir": "4",
    "resolve-cwd": "^3.0.0",
    "zod": "4.4.3"
  }
}
