{
  "name": "@mercurjs/admin",
  "version": "2.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/mercurjs/mercur",
    "directory": "packages/admin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    },
    "./extension-targets": {
      "types": "./dist/extension-targets.d.ts",
      "import": "./dist/extension-targets.js"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "generate:targets": "bun run scripts/generate-extension-targets.ts",
    "build": "tsup && bun run generate:targets",
    "lint": "oxlint --max-warnings 0"
  },
  "dependencies": {
