{
  "name": "@mercurjs/cli",
  "version": "2.2.0-canary.48",
  "repository": {
    "type": "git",
    "url": "https://github.com/mercurjs/mercur",
    "directory": "packages/cli"
  },
  "type": "module",
  "description": "Mercur CLI",
  "author": "MercurJS (https://github.com/mercurjs)",
  "keywords": [
    "marketplace",
    "multi-vendor",
    "medusajs",
    "ecommerce",
    "open-source-marketplace",
    "headless-commerce",
    "ai-ready",
    "marketplace-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "mercurjs": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "build": "bun scripts/generate-routes-manifest.ts && tsup",
    "routes-manifest": "bun scripts/generate-routes-manifest.ts"
  },
  "dependencies": {
    "@antfu/ni": "^27.0.1",
    "@medusajs/admin-bundler": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@mercurjs/dashboard-sdk": "2.2.0-canary.48",
    "@vitejs/plugin-react": "^4.2.1",
    "commander": "^14.0.2",
    "cosmiconfig": "^9.0.0",
    "deepmerge": "^4.3.1",
    "diff": "^8.0.2",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "kleur": "^4.1.5",
    "ora": "^9.0.0",
    "pkg-dir": "^9.0.0",
    "prompts": "^2.4.2",
    "resolve-cwd": "^3.0.0",
    "ts-morph": "^27.0.2",
    "tsconfig-paths": "^4.2.0",
    "vite": "^8.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
