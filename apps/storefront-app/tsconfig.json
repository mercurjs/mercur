{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "bun"]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "desktop/**/*.ts",
    "capacitor.config.ts"
  ]
}
