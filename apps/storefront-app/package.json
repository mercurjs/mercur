{
  "name": "@mercurjs/storefront-app",
  "version": "2.1.1",
  "private": true,
  "description": "Store-ready shells for the Mercur B2C storefront (PWA, iOS, Android, desktop).",
  "main": ".electron/main.js",
  "scripts": {
    "icons": "bun scripts/generate-icons.ts",
    "test": "bun test packaging.test resolve-url.test",
    "dev:web": "bun scripts/dev.ts --target web",
    "dev:macos": "bun scripts/dev.ts --target macos",
    "dev:windows": "bun scripts/dev.ts --target windows",
    "dev:linux": "bun scripts/dev.ts --target linux",
    "dev:ios": "bun scripts/dev.ts --target ios",
    "dev:android": "bun scripts/dev.ts --target android",
    "dev:device": "bun scripts/dev.ts --target device",
    "package:desktop": "bun scripts/package-desktop.ts",
    "package:ios": "CAP_TARGET=ios-simulator bunx cap sync ios && bunx cap open ios",
    "package:android": "CAP_TARGET=android-emulator bunx cap sync android && bunx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.17.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  }
}
