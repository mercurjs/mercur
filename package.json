{
  "name": "mercur",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --quiet",
    "test:unit": "cd integration-tests && bun run test:unit",
    "test:integration:http": "cd integration-tests && bun run test:integration:http"
  },
  "dependencies": {
    "@mercurjs/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.0.0",
    "oxlint": "^1.64.0",
    "pg-god": "^1.0.12",
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*",
    "integration-tests",
    "e2e-tests",
    "e2e-tests/hosts/*"
  ],
  "overrides": {
    "@medusajs/admin-bundler": "2.20.1",
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/admin-shared": "2.20.1",
    "@medusajs/admin-vite-plugin": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/core-flows": "2.20.1",
    "@medusajs/dashboard": "2.20.1",
    "@medusajs/draft-order": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/icons": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@medusajs/test-utils": "2.20.1",
    "@medusajs/types": "2.20.1",
    "@medusajs/ui": "4.2.3",
    "@medusajs/ui-preset": "2.20.1",
    "zod": "3.25.76",
    "tailwindcss": "3.4.19",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7"
  }
}
